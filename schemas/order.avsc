{
  "namespace": "com.ruhuna.ec8202.orders",
  "type": "record",
  "name": "Order",
  "doc": "A single purchase transaction emitted by the storefront.",
  "fields": [
    { "name": "orderId", "type": "string", "doc": "Unique identifier for the order, e.g. \"1001\"." },
    { "name": "product", "type": "string", "doc": "Name of the purchased item, e.g. \"Item1\"." },
    { "name": "price",   "type": "float",  "doc": "Price of the product in LKR." }
  ]
}
